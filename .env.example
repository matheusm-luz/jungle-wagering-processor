# Only needed to run the application on the host (`bun run start`) against the Compose
# dependencies (`docker compose up -d postgres localstack`). Inside Compose every value is
# set by compose.yaml. Copy to `.env`; Bun loads it automatically.

PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
DATABASE_CONNECT_TIMEOUT_MS=5000
# ADR-01: waiting longer than this for a wallet lock fails the transaction (transient).
DATABASE_LOCK_TIMEOUT_MS=5000

AWS_REGION=us-east-1
# LocalStack. Leave unset on AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack accepts any credentials; the AWS SDK requires some.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

WAGER_TRANSACTIONS_QUEUE_NAME=wager-transactions.fifo
WAGER_TRANSACTIONS_DLQ_NAME=wager-transactions-dlq.fifo

# SQS consumer (ADR-05): loops of one message each; a transient failure stays invisible for
# min(RETRY_MAX_DELAY, RETRY_BASE_DELAY x 2^(receives-1)) seconds; the redrive policy dead-letters
# after 5 receives. On SIGTERM, an open long poll ends within WAIT_TIME_S and in-flight messages get
# SHUTDOWN_GRACE_MS; whatever is left gets its visibility back.
SQS_CONSUMER_CONCURRENCY=5
SQS_WAIT_TIME_S=10
SQS_VISIBILITY_TIMEOUT_S=30
SQS_RETRY_BASE_DELAY_S=5
SQS_RETRY_MAX_DELAY_S=120
SQS_SHUTDOWN_GRACE_MS=10000
READINESS_TIMEOUT_MS=2000

# Pending-reference worker (ADR-05): backoff min(MAX_DELAY, BASE_DELAY x 2^(n-1)), MAX_ATTEMPTS
# worker attempts, then REJECTED with REFERENCE_NOT_FOUND.
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_POLL_INTERVAL_MS=500
PENDING_REFERENCE_BATCH_SIZE=10
