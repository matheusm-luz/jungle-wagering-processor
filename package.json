{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "migrate": "bun src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "bun test ./test/unit",
    "test:integration": "docker compose --profile test run --rm --build test bun test ./test/integration",
    "test:concurrency": "docker compose --profile test run --rm --build test bun test ./test/concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1168.0",
    "@aws-sdk/client-sqs": "3.1168.0",
    "@mikro-orm/core": "7.2.9",
    "@mikro-orm/migrations": "7.2.9",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.9",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "typescript": "7.0.2"
  }
}
